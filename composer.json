{
    "name": "javaabu/settings",
    "description": "Settings for Laravel defined once with javaabu/stencil: the field, default and validation in one place, with typed access, automatic settings pages in Blade or Inertia React, and queue workers that pick up changes",
    "homepage": "https://github.com/javaabu/settings",
    "license": "MIT",
    "keywords": [
        "javaabu",
        "laravel",
        "settings",
        "stencil",
        "inertia",
        "dhivehi"
    ],
    "authors": [
        {
            "name": "Athfan Khaleel",
            "email": "athfan@javaabu.com"
        },
        {
            "name": "Javaabu Pvt. Ltd.",
            "email": "info@javaabu.com",
            "homepage": "https://javaabu.com",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/forms"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/manifest"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/permissions"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/stencil"
        },
        {
            "type": "vcs",
            "url": "https://github.com/n4ff4h/translatable"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/cache": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/queue": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/validation": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0",
        "javaabu/forms": "^2.0@dev",
        "javaabu/manifest": "^1.0@dev",
        "javaabu/permissions": "^3.0@dev",
        "javaabu/stencil": "^1.0@dev"
    },
    "require-dev": {
        "inertiajs/inertia-laravel": "^2.0",
        "javaabu/boost-javaabu-guidelines": "^1.4",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5.3 || ^12.5.8",
        "spatie/laravel-activitylog": "^4.10"
    },
    "suggest": {
        "inertiajs/inertia-laravel": "Renders the settings pages with Inertia React when settings.views is inertia (^2.0)",
        "javaabu/translatable": "One value per language for translatable settings (^3.0)",
        "spatie/laravel-activitylog": "Logs every change to the settings (^4.10)"
    },
    "autoload": {
        "psr-4": {
            "Javaabu\\Settings\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Javaabu\\Settings\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-clover build/coverage.xml",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "branch-alias": {
            "dev-next-gen": "2.x-dev"
        },
        "laravel": {
            "providers": [
                "Javaabu\\Settings\\SettingsServiceProvider"
            ],
            "aliases": {
                "Settings": "Javaabu\\Settings\\Facades\\Settings"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
